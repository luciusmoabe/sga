{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "server/logic.js",
    "public/js/regras.js",
    "public/js/datas.js",
    "public/js/gestao-calculo.js",
    "public/js/reuniao-da-acao.js",
    "public/js/filtro-acoes.js",
    "public/js/vocabulario.js",
    "public/js/ata-marcacao.js"
  ]
}

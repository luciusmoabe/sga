PORT=3000
# Padrão institucional. Nunca use demo em implantação.
SGC_AUTH_MODE=entra
SGC_PUBLIC_ORIGIN=https://agilis.exemplo.gov.br
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Configure o valor do segredo somente no ambiente seguro do servidor.
ENTRA_CLIENT_SECRET=

# Backend PostgreSQL (não enviar ao navegador).
DATABASE_URL=
# Destino explícito para migração e vínculo administrativo.
SGC_MIGRATION_DATABASE_URL=
# CA oficial do servidor, quando não estiver no trust store do sistema.
SGC_PG_CA_FILE=
SGC_PG_SSL=verify
# Demonstração local: SGC_AUTH_MODE=demo, DATABASE_URL vazia e SGC_DB isolado.

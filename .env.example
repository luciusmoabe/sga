PORT=3000
# Padrão institucional (Supabase Auth, e-mail e senha). Nunca use demo em implantação.
SGC_AUTH_MODE=supabase
SGC_PUBLIC_ORIGIN=https://agilis.exemplo.gov.br
SUPABASE_URL=
# Chave publishable ou anon. Nunca use chave secret/service_role.
SUPABASE_PUBLISHABLE_KEY=
# Exclusiva do servidor: criação de contas pelo Diretor (não substitui a chave pública).
SUPABASE_SERVICE_ROLE_KEY=

# Backend PostgreSQL (não enviar ao navegador).
DATABASE_URL=
# Destino explícito para migração e vínculo administrativo.
SGC_MIGRATION_DATABASE_URL=
# CA oficial do servidor, quando não estiver no trust store do sistema.
SGC_PG_CA_FILE=
SGC_PG_SSL=verify
# Demonstração local: SGC_AUTH_MODE=demo, DATABASE_URL vazia e SGC_DB isolado.

# Comando do primeiro Administrador (npm run admin:criar): senha provisória, só neste comando; nunca versionar.
# SGC_ADMIN_SENHA_INICIAL=
# SGC_ADMIN_SUBJECT=   (UUID de uma conta que já existe no Supabase: só vincula, sem criar nem definir senha)

# Proxy confiável (IP real no limite de tentativas de login). Ativo por padrão na Vercel; fora dela,
# defina o número de proxies entre o usuário e o servidor (ex.: 1). Deixe vazio sem proxy.
SGC_TRUST_PROXY=
